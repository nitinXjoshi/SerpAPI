{
  "name": "serpapi-google-finance-viewer",
  "version": "1.2.0",
  "private": true,
  "description": "SerpAPI Google Finance/News explorer + authenticated, multi-stock trading-intelligence dashboard",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "demo": "node scripts/demo.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/checks.js",
    "audit": "npm audit --audit-level=moderate",
    "verify": "npm run check && npm test"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "engines": {
    "node": ">=22.5"
  }
}
