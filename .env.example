# Copy this file to `.env` and fill in what you need. Never commit real keys.

# --- Server ---
# PORT=3000
# DATA_DIR=./data
# LOG_LEVEL=info

# --- Provider keys (optional here; the dashboard API Keys page is preferred) ---
# Get a SerpApi key at https://serpapi.com/manage-api-key
# SERPAPI_API_KEY=
# Get a Twelve Data key at https://twelvedata.com/register (free Basic tier)
# TWELVEDATA_API_KEY=

# --- Secrets encryption (keep OUTSIDE the database) ---
# 32-byte key (64 hex chars or base64). If unset, a keyfile is generated at $DATA_DIR/encryption.key
# APP_ENCRYPTION_KEY=

# --- Ollama (local) ---
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=
# OLLAMA_TIMEOUT_MS=60000

# --- Demo mode: force synthetic fixture providers (no external calls) ---
# DEMO_MODE=false
